{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ompMiniDesktop",
  "version": "0.1.0",
  "identifier": "com.omnidesktop.mini",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ompMiniDesktop",
        "width": 1200,
        "height": 800,
        "minWidth": 375,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ompMiniDesktop",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
