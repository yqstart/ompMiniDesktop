{
  "name": "omp-mini-desktop",
  "version": "0.1.0",
  "description": "oh-my-pi 极简桌面端（Tauri v2 + React）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yqstart/ompMiniDesktop.git"
  },
  "homepage": "https://github.com/yqstart/ompMiniDesktop#readme",
  "bugs": {
    "url": "https://github.com/yqstart/ompMiniDesktop/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts --max-warnings 0",
    "e2e:ipc": "node scripts/e2e-ipc-selfcheck.mjs",
    "e2e:rpc": "node scripts/e2e-rpc.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm e2e:ipc && pnpm e2e:rpc",
    "icon": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "reicon-react": "^1.2.5",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
